          <mxGeometry height="124" width="250" x="332" y="176" as="geometry" />
        </mxCell>
        <mxCell id="x9" parent="x_b" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#e8ebee;strokeColor=#9aa4ad;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;X9&lt;/font&gt;&amp;nbsp; &lt;b&gt;Fast fallback&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;After a worker error or an empty page, PyMuPDF4LLM reads the text layer without layout. Marked uncertain, with the reason.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;extract_fast_page()&lt;/font&gt;" vertex="1">
          <mxGeometry height="124" width="250" x="16" y="176" as="geometry" />
        </mxCell>
        <mxCell id="x10" parent="x_b" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;X10&lt;/font&gt;&amp;nbsp; &lt;b&gt;Label blocks + report&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;“Table 2:” and “Figure A1.” become captions. Font size suggests heading depth. One JSON report per PDF.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;extract_text_pages()&lt;/font&gt;" vertex="1">
          <mxGeometry height="124" width="250" x="332" y="338" as="geometry" />
        </mxCell>
        <mxCell id="x_card" parent="x_b" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=13;fontColor=#333333;fillColor=#fbfbf9;strokeColor=#b8b8b3;strokeWidth=1;" value="&lt;b&gt;Page reading rules&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Kept:&lt;/b&gt; text, title, section header, caption, list item, footnote, code.&lt;br&gt;&lt;br&gt;&lt;b&gt;Skipped:&lt;/b&gt; table, picture, formula, page header, page footer. Table cells are not indexed, only their captions.&lt;br&gt;&lt;br&gt;&lt;b&gt;Worker process:&lt;/b&gt; one model serves every page, and a crash cannot take down the run. Slow pages print a warning but never time out.&lt;br&gt;&lt;br&gt;&lt;b&gt;Every page records:&lt;/b&gt; extraction_method, structure_confidence and review_reason." vertex="1">
          <mxGeometry height="216" width="566" x="16" y="498" as="geometry" />
        </mxCell>
