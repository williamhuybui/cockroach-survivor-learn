        </mxCell>
        <mxCell id="box1" parent="1" style="swimlane;html=1;whiteSpace=wrap;startSize=72;horizontal=1;rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#e2e2de;swimlaneFillColor=#f3f3f1;strokeColor=#8f8f8a;strokeWidth=2;fontSize=14;fontColor=#202124;align=center;verticalAlign=middle;collapsible=0;container=1;swimlaneLine=1;" value="&lt;b style=&quot;font-size:24px&quot;&gt;2. Planner&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:13px&quot;&gt;Turns one question into checked search tasks. The model proposes; Python decides the paper scope.&lt;/font&gt;" vertex="1">
          <mxGeometry height="1060" width="1600" x="40" y="1406" as="geometry" />
        </mxCell>
        <mxCell id="p_a" parent="box1" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fillColor=#ffffff;strokeColor=#c4c4bf;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;spacing=0;fontSize=13;fontColor=#555555;" value="&lt;b&gt;A. Find the papers&lt;/b&gt;" vertex="1">
          <mxGeometry height="934" width="282" x="28" y="92" as="geometry" />
        </mxCell>
        <mxCell id="p1" parent="p_a" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#dce9fa;strokeColor=#6da5df;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size: 11px;&quot;&gt;P1&lt;/font&gt;&amp;nbsp; &lt;b&gt;Question + history&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size: 12px;&quot;&gt;The user&#39;s question and the last 6 chat messages if using UI&lt;/font&gt;" vertex="1">
          <mxGeometry height="108" width="250" x="16" y="34" as="geometry" />
        </mxCell>
        <mxCell id="p2" parent="p_a" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;P2&lt;/font&gt;&amp;nbsp; &lt;b&gt;Find paper references&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;Python matches the question against catalog names: clear titles, weak candidates, ambiguous flag.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;find_paper_references()&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="250" x="16" y="184" as="geometry" />
        </mxCell>
        <mxCell id="p_cat" parent="p_a" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=4;fontSize=14;fontColor=#202124;fillColor=#e3f1e1;strokeColor=#81b782;strokeWidth=1.5;" value="&lt;b&gt;Paper catalog&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size: 12px;&quot;&gt;Assembled when planning starts&lt;br&gt;Indexed papers + catalog details + aliases. Output stored in SQLite&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#666666&quot; style=&quot;font-size: 11px;&quot;&gt;list_indexed_papers()&lt;/font&gt;" vertex="1">
          <mxGeometry height="108" width="250" x="16" y="346" as="geometry" />
        </mxCell>
        <mxCell id="p_card_names" parent="p_a" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=13;fontColor=#333333;fillColor=#fbfbf9;strokeColor=#b8b8b3;strokeWidth=1;" value="&lt;b&gt;Where the catalog comes from&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Chroma:&lt;/b&gt; indexed paper IDs, filenames, source links and first-page text for possible author clues.&lt;br&gt;&lt;br&gt;&lt;b&gt;index.csv:&lt;/b&gt; paper titles, numbers, years and arXiv links. &lt;b&gt;Reading guide:&lt;/b&gt; recommended reading depth.&lt;br&gt;&lt;br&gt;&lt;b&gt;SQLite:&lt;/b&gt; maintained aliases, if available; alias defaults can also be used.&lt;br&gt;&lt;br&gt;&lt;b&gt;How names are matched&lt;/b&gt;&lt;br&gt;Compare titles and aliases; derive some names from titles. Author clues may produce candidates. Ambiguous names remain uncertain.&lt;br&gt;&lt;br&gt;&lt;b&gt;Example:&lt;/b&gt; “What does RAG use?” → find the indexed RAG paper → search its text for evidence." vertex="1">
          <mxGeometry height="394" width="250" x="16" y="484" as="geometry" />
        </mxCell>
        <mxCell id="e1_p1_p2" edge="1" parent="p_a" source="p1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="p2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2_p_cat_p2" edge="1" parent="p_a" source="p_cat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#5f9a60;dashed=1;fontSize=11;fontColor=#3f6f40;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="p2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p_b" parent="box1" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fillColor=#ffffff;strokeColor=#c4c4bf;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;spacing=0;fontSize=13;fontColor=#555555;" value="&lt;b&gt;B. Build the tasks&lt;/b&gt;" vertex="1">
          <mxGeometry height="934" width="598" x="344" y="92" as="geometry" />
        </mxCell>
        <mxCell id="p3" parent="p_b" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=40;spacingRight=40;fontSize=13;fontColor=#202124;fillColor=#fff4ce;strokeColor=#e2b94b;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;P3&lt;/font&gt;&lt;br&gt;&lt;b&gt;Can Python split clear question parts?&lt;/b&gt;" vertex="1">
          <mxGeometry height="124" width="250" x="16" y="26" as="geometry" />
        </mxCell>
        <mxCell id="p4" parent="p_b" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;P4&lt;/font&gt;  &lt;b&gt;Yes: Python creates tasks&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;Use the user’s words for each clear question and its paper. No Gemma planning call.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;plan_explicit_clauses()&lt;/font&gt;" vertex="1">
          <mxGeometry height="124" width="250" x="332" y="26" as="geometry" />
        </mxCell>
        <mxCell id="p5" parent="p_b" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;P5&lt;/font&gt; &lt;b&gt;Prepare for Gemma&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;When neither Python route applies, send the question, available history and indexed paper choices for planning.&lt;/font&gt;" vertex="1">
          <mxGeometry height="112" width="250" x="16" y="184" as="geometry" />
        </mxCell>
        <mxCell id="p6" parent="p_b" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#ffe2c0;strokeColor=#e59945;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;P6&lt;/font&gt;  &lt;b&gt;Gemma proposes tasks&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;Interpret the question and suggest focused searches, paper choices and any clarification. Does not answer yet.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;request_structured_response()&lt;/font&gt;" vertex="1">
          <mxGeometry height="112" width="250" x="16" y="334" as="geometry" />
        </mxCell>
        <mxCell id="p7" parent="p_b" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=40;spacingRight=40;fontSize=13;fontColor=#202124;fillColor=#fff4ce;strokeColor=#e2b94b;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;P7&lt;/font&gt;&lt;br&gt;&lt;b&gt;Same question for each paper?&lt;/b&gt;" vertex="1">
          <mxGeometry height="124" width="250" x="16" y="476" as="geometry" />
        </mxCell>
        <mxCell id="p8" parent="p_b" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;P8&lt;/font&gt; &lt;b&gt;Create one task per paper&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;Ask the same thing for each paper separately. Keep any unidentified subject as unresolved.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;per_paper_tasks()&lt;/font&gt;" vertex="1">
          <mxGeometry height="124" width="250" x="332" y="476" as="geometry" />
        </mxCell>
        <mxCell id="p9" parent="p_b" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;P9&lt;/font&gt; &lt;b&gt;Check each task’s scope&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;Python checks Gemma’s paper choice and assigns one scope: paper, broad or unresolved.&lt;/font&gt;" vertex="1">
          <mxGeometry height="108" width="250" x="16" y="634" as="geometry" />
        </mxCell>
        <mxCell id="p_card_scope" parent="p_b" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=12;fontColor=#333333;fillColor=#fbfbf9;strokeColor=#b8b8b3;strokeWidth=1;" value="&lt;b&gt;Three scopes used by retrieval&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;paper:&lt;/b&gt; Search one or more identified papers. A task may carry candidates that retrieval tries to resolve.&lt;br&gt;&lt;br&gt;&lt;b&gt;broad:&lt;/b&gt; Search across the collection.&lt;br&gt;&lt;br&gt;&lt;b&gt;unresolved:&lt;/b&gt; The requested paper is unclear; do not search this task.&lt;br&gt;&lt;br&gt;Python-created tasks use these same scope values." vertex="1">
          <mxGeometry height="166" width="250" x="332" y="626" as="geometry" />
        </mxCell>
        <mxCell id="p10" parent="p_b" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size: 11px;&quot;&gt;P10&lt;/font&gt; &lt;b&gt;Clean up the tasks&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size: 12px;&quot;&gt;Remove duplicates and split some tasks with 3+ papers.&lt;/font&gt;" vertex="1">
          <mxGeometry height="118" width="250" x="16" y="784" as="geometry" />
        </mxCell>
