        </mxCell>
        <mxCell id="r2" parent="r_a" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=40;spacingRight=40;fontSize=13;fontColor=#202124;fillColor=#fff4ce;strokeColor=#e2b94b;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;R2&lt;/font&gt;&lt;br&gt;&lt;b&gt;Task marked unresolved?&lt;/b&gt;" vertex="1">
