          <mxGeometry height="92" width="250" x="332" y="540" as="geometry" />
        </mxCell>
        <mxCell id="r7" parent="r_a" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;R7&lt;/font&gt;&amp;nbsp; &lt;b&gt;BM25 keyword search&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;Python scores every chunk in scope; no search server. Top 24. Names and numbers match literally.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;find_bm25_candidates()&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="250" x="332" y="714" as="geometry" />
        </mxCell>
        <mxCell id="r8" parent="r_a" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;R8&lt;/font&gt;&amp;nbsp; &lt;b&gt;Merge + dedupe&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;Union of both lists by chunk ID. At most 144 candidates.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;find_hybrid_candidates()&lt;/font&gt;" vertex="1">
          <mxGeometry height="108" width="250" x="648" y="536" as="geometry" />
        </mxCell>
        <mxCell id="r9" parent="r_a" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#ffe2c0;strokeColor=#e59945;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;R9&lt;/font&gt;&amp;nbsp; &lt;b&gt;MiniLM reranker&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;Cross-encoder scores each (query, child chunk) pair. Keeps score ≥ 1.5, best first.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;rerank_passage_candidates()&lt;/font&gt;" vertex="1">
          <mxGeometry height="108" width="250" x="964" y="536" as="geometry" />
        </mxCell>
        <mxCell id="r10" parent="r_a" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;R10&lt;/font&gt;&amp;nbsp; &lt;b&gt;Expand to parent section&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;Fetch the section by parent_id. Window up to 2,400 characters, starting 350 before the child. One per section, up to 5 per search.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;expand_parent_section_windows()&lt;/font&gt;" vertex="1">
