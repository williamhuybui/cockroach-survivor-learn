        <mxCell id="e_direct_yes" edge="1" parent="p_b" source="p_direct_check" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" target="p_direct_task" value="yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p_c" parent="box1" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fillColor=#ffffff;strokeColor=#c4c4bf;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;spacing=0;fontSize=13;fontColor=#555555;" value="&lt;b&gt;C. Check and hand off&lt;/b&gt;" vertex="1">
          <mxGeometry height="934" width="598" x="976" y="92" as="geometry" />
        </mxCell>
        <mxCell id="p_rule" parent="p_c" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=12;fontColor=#333333;fillColor=#fffdf4;strokeColor=#e2b94b;strokeWidth=1;" value="&lt;b&gt;Planner rule&lt;/b&gt;&lt;br&gt;The planner never receives passages, expected answers or evaluation labels. The model can suggest a paper, but Python keeps it only if the user&#39;s own words name it. Only Python can supply candidate papers." vertex="1">
          <mxGeometry height="92" width="566" x="16" y="26" as="geometry" />
        </mxCell>
        <mxCell id="p11" parent="p_c" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#dce9fa;strokeColor=#6da5df;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;P11&lt;/font&gt;&amp;nbsp; &lt;b&gt;Approved plan (browser)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;A plan the user approved skips planning. If its papers left the index, the user is asked to revise.&lt;/font&gt;" vertex="1">
          <mxGeometry height="108" width="250" x="16" y="190" as="geometry" />
        </mxCell>
        <mxCell id="p12" parent="p_c" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=40;spacingRight=40;fontSize=13;fontColor=#202124;fillColor=#fff4ce;strokeColor=#e2b94b;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;P12&lt;/font&gt;&amp;nbsp; &lt;b&gt;Need the user first?&lt;/b&gt;" vertex="1">
          <mxGeometry height="124" width="250" x="16" y="476" as="geometry" />
        </mxCell>
        <mxCell id="p13" parent="p_c" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#e8ebee;strokeColor=#9aa4ad;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;P13&lt;/font&gt;&amp;nbsp; &lt;b&gt;Stop before searching&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;Browser: ask for clarification, or show a multi-task plan to approve. Automatic calls: “I don&#39;t know - …”.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;choose_route_after_planning()&lt;/font&gt;" vertex="1">
          <mxGeometry height="124" width="250" x="16" y="646" as="geometry" />
        </mxCell>
        <mxCell id="p14" parent="p_c" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;P14&lt;/font&gt;&amp;nbsp; &lt;b&gt;Limit the batch&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;Up to 5 searches per response (14,000 ÷ 2,400 characters). Unresolved tasks take no slot. The rest are listed as unfinished.&lt;/font&gt;" vertex="1">
          <mxGeometry height="124" width="250" x="332" y="476" as="geometry" />
        </mxCell>
        <mxCell id="p15" parent="p_c" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#dce9fa;strokeColor=#6da5df;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;P15&lt;/font&gt;&amp;nbsp; &lt;b&gt;Search tasks&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;Goes to retrieval, one entry per requested result.&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="250" x="332" y="324" as="geometry" />
        </mxCell>
        <mxCell id="p_card_task" parent="p_c" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=12;fontColor=#333333;fillColor=#fbfbf9;strokeColor=#b8b8b3;strokeWidth=1;" value="&lt;b&gt;What each task carries&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;question&lt;/b&gt;: stand-alone wording, never an answer&lt;br&gt;&lt;b&gt;paper&lt;/b&gt;: one title, a list, or none&lt;br&gt;&lt;b&gt;candidate_papers&lt;/b&gt;: possible titles, from Python only&lt;br&gt;&lt;b&gt;scope&lt;/b&gt;: paper, broad or unresolved&lt;br&gt;&lt;br&gt;&lt;b&gt;route&lt;/b&gt; (whole plan): direct, multipart or comparison" vertex="1">
          <mxGeometry height="192" width="250" x="332" y="646" as="geometry" />
        </mxCell>
