        </mxCell>
        <mxCell id="r4" parent="r_a" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size: 11px;&quot;&gt;R4&lt;/font&gt;&amp;nbsp; &lt;b&gt;Build the query&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size: 12px;&quot;&gt;The task&#39;s question. May include the user’s full question in the search text to help explain a short sub-question.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#666666&quot; style=&quot;font-size: 11px;&quot;&gt;retrieve_task_evidence()&lt;/font&gt;" vertex="1">
          <mxGeometry height="112" width="250" x="16" y="358" as="geometry" />
        </mxCell>
