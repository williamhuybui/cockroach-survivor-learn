        <mxCell id="e48_g8_g9" edge="1" parent="g_a" source="g8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="g9" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box4" parent="1" style="swimlane;html=1;whiteSpace=wrap;startSize=72;horizontal=1;rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#e2e2de;swimlaneFillColor=#f3f3f1;strokeColor=#8f8f8a;strokeWidth=2;fontSize=14;fontColor=#202124;align=center;verticalAlign=middle;collapsible=0;container=1;swimlaneLine=1;" value="&lt;b style=&quot;font-size:24px&quot;&gt;1. Extraction and chunking&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:13px&quot;&gt;Runs by hand before any question. Turns PDFs into searchable child chunks that link back to full sections.&lt;/font&gt;" vertex="1">
          <mxGeometry height="1156" width="1600" x="40" y="130" as="geometry" />
        </mxCell>
        <mxCell id="x_a" parent="box4" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fillColor=#ffffff;strokeColor=#c4c4bf;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;spacing=0;fontSize=13;fontColor=#555555;" value="&lt;b&gt;A. Sources&lt;/b&gt;" vertex="1">
          <mxGeometry height="774" width="282" x="28" y="92" as="geometry" />
        </mxCell>
        <mxCell id="x1" parent="x_a" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#dce9fa;strokeColor=#6da5df;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;X1&lt;/font&gt;&amp;nbsp; &lt;b&gt;Google Drive folder&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;Research PDFs, index.csv and the reading guide.&lt;/font&gt;" vertex="1">
          <mxGeometry height="88" width="250" x="16" y="40" as="geometry" />
        </mxCell>
        <mxCell id="x2" parent="x_a" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;X2&lt;/font&gt;&amp;nbsp; &lt;b&gt;Sync + manifest&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;Downloads the files. sources.local.json keeps each file&#39;s Drive ID, path, title and link.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;drive_sync.py&lt;/font&gt;" vertex="1">
