          <mxGeometry height="108" width="250" x="16" y="720" as="geometry" />
        </mxCell>
        <mxCell id="r6" parent="r_a" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#ffe2c0;strokeColor=#e59945;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;R6&lt;/font&gt;&amp;nbsp; &lt;b&gt;Vector search&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;EmbeddingGemma embeds the query. Chroma cosine search, top 120, same paper filter.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;find_vector_candidates()&lt;/font&gt;" vertex="1">
          <mxGeometry height="112" width="250" x="332" y="358" as="geometry" />
        </mxCell>
