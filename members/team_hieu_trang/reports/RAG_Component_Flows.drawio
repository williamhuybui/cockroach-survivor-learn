        <mxCell id="x7" parent="x_b" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;X7&lt;/font&gt;&amp;nbsp; &lt;b&gt;Read the kept regions&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;Reads each region from the PDF&#39;s text layer, in the model&#39;s order. Records heading font sizes.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;extract_region_text()&lt;/font&gt;" vertex="1">
