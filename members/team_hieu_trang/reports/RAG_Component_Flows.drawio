        <mxCell id="x11" parent="x_c" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;X11&lt;/font&gt;&amp;nbsp; &lt;b&gt;Clean text&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;Expands ligatures, joins soft hyphens, drops invisible characters. Ordinary hyphens and numbers stay.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;clean_pdf_text()&lt;/font&gt;" vertex="1">
          <mxGeometry height="118" width="250" x="16" y="26" as="geometry" />
        </mxCell>
        <mxCell id="x12" parent="x_c" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size: 11px;&quot;&gt;X12&lt;/font&gt;&amp;nbsp; &lt;b&gt;Group into parent sections&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size: 12px;&quot;&gt;Heading + its text = one section, with breadcrumb and page span. “2.1” sets depth. No headings at all: one section per page. A fallback page is its own section.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#666666&quot; style=&quot;font-size: 11px;&quot;&gt;group_layout_pages_into_sections()&lt;/font&gt;" vertex="1">
