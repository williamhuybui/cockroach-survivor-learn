        <mxCell id="r_b" parent="box2" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fillColor=#ffffff;strokeColor=#c4c4bf;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;spacing=0;fontSize=13;fontColor=#555555;" value="&lt;b&gt;B. Combine all tasks&lt;/b&gt;" vertex="1">
          <mxGeometry height="160" width="1544" x="28" y="962" as="geometry" />
        </mxCell>
        <mxCell id="r13" parent="r_b" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size: 11px;&quot;&gt;R13&lt;/font&gt;&amp;nbsp;&lt;b&gt;Experimental&lt;/b&gt;&amp;nbsp;&lt;b&gt;Retry empty tasks&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size: 12px;&quot;&gt;If Task 1 finds evidence but Task 2’s passages all fall below the cutoff (considered empty task), keep Task 2’s two best passages. A lower-scoring passage may still contain the answer.&lt;/font&gt;" vertex="1">
          <mxGeometry height="118" width="250" x="964" y="30" as="geometry" />
        </mxCell>
        <mxCell id="r14" parent="r_b" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;R14&lt;/font&gt;&amp;nbsp; &lt;b&gt;Share the budget&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;14,000 characters in total. Tasks take turns, each capped at an equal share. Windows are never cut. A shared passage is stored once.&lt;/font&gt;" vertex="1">
          <mxGeometry height="118" width="250" x="648" y="30" as="geometry" />
        </mxCell>
        <mxCell id="r15" parent="r_b" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;R15&lt;/font&gt;&amp;nbsp; &lt;b&gt;Assign source labels&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;S1, S2 … grouped by task. A premise correction counts only if its passage kept a label.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;assign_citation_labels()&lt;/font&gt;" vertex="1">
          <mxGeometry height="118" width="250" x="332" y="30" as="geometry" />
        </mxCell>
        <mxCell id="r16" parent="r_b" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#dce9fa;strokeColor=#6da5df;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;R16&lt;/font&gt;&amp;nbsp; &lt;b&gt;Evidence&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;Labelled passages with title, location and link, plus premise corrections.&lt;/font&gt;" vertex="1">
          <mxGeometry height="118" width="250" x="16" y="30" as="geometry" />
        </mxCell>
        <mxCell id="r_card_funnel" parent="r_b" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=13;fontColor=#333333;fillColor=#fffdf4;strokeColor=#e2b94b;strokeWidth=1;" value="&lt;b&gt;The funnel&lt;/b&gt;&lt;br&gt;120 vector + 24 keyword → score ≥ 1.5 → up to 5 windows per search → 14,000 characters for the whole answer." vertex="1">
          <mxGeometry height="118" width="250" x="1280" y="30" as="geometry" />
        </mxCell>
        <mxCell id="e35_r13_r14" edge="1" parent="r_b" source="r13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="r14" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e36_r14_r15" edge="1" parent="r_b" source="r14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="r15" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e37_r15_r16" edge="1" parent="r_b" source="r15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="r16" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e34_r12_r13" edge="1" parent="box2" source="r12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="r13" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box3" parent="1" style="swimlane;html=1;whiteSpace=wrap;startSize=72;horizontal=1;rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#e2e2de;swimlaneFillColor=#f3f3f1;strokeColor=#8f8f8a;strokeWidth=2;fontSize=14;fontColor=#202124;align=center;verticalAlign=middle;collapsible=0;container=1;swimlaneLine=1;" value="&lt;b style=&quot;font-size:24px&quot;&gt;4. Generate and check the answer&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:13px&quot;&gt;Gemma uses the selected evidence; Python checks draft details against the available passages.&lt;/font&gt;" vertex="1">
          <mxGeometry height="1060" width="1600" x="1790" y="1406" as="geometry" />
        </mxCell>
        <mxCell id="g_a" parent="box3" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fillColor=#ffffff;strokeColor=#c4c4bf;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=156;spacingTop=4;spacing=0;fontSize=13;fontColor=#555555;" value="&lt;b&gt;Generate and check process, at answer time&lt;/b&gt;" vertex="1">
          <mxGeometry height="934" width="1544" x="29" y="92" as="geometry" />
        </mxCell>
        <mxCell id="g1" parent="g_a" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=40;spacingRight=40;fontSize=13;fontColor=#202124;fillColor=#fff4ce;strokeColor=#e2b94b;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;G1&lt;/font&gt;&amp;nbsp; &lt;b&gt;Any evidence?&lt;/b&gt;" vertex="1">
          <mxGeometry height="124" width="250" x="16" y="26" as="geometry" />
        </mxCell>
        <mxCell id="g2" parent="g_a" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#e8ebee;strokeColor=#9aa4ad;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;G2&lt;/font&gt;&amp;nbsp; &lt;b&gt;Abstain without Gemma&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;“I don&#39;t know - this is not in the documents.” Gemma is not asked to guess.&lt;/font&gt;" vertex="1">
          <mxGeometry height="108" width="250" x="16" y="190" as="geometry" />
        </mxCell>
        <mxCell id="g_card" parent="g_a" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=13;fontColor=#333333;fillColor=#fffdf4;strokeColor=#e2b94b;strokeWidth=1;" value="&lt;b&gt;What these checks can prove&lt;/b&gt;&lt;br&gt;The gates compare citations, scope, numbers, units and wording. They cannot prove that the meaning is right, or that retrieval found the best passage. They run automatically, with no human review.&lt;br&gt;&lt;br&gt;&lt;b&gt;Example&lt;/b&gt;&lt;br&gt;Asked for the pre-training batch size, the draft gives the fine-tuning value. Gate 10 rejects it and the task is listed under “Missing information”.&lt;br&gt;&lt;br&gt;&lt;b&gt;When G3 says yes&lt;/b&gt;&lt;br&gt;Gemma is skipped. An empty draft passes through the gates and G7 adds the corrections." vertex="1">
          <mxGeometry height="340" width="250" x="16" y="340" as="geometry" />
        </mxCell>
        <mxCell id="g_truth_card" parent="g_a" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=9;fontSize=13;fontColor=#333333;fillColor=#fffdf4;strokeColor=#e2b94b;strokeWidth=1;" value="&lt;b&gt;What the agent uses as evidence&lt;/b&gt;&lt;br&gt;&lt;b&gt;Selected passages:&lt;/b&gt; retrieved text labeled S1, S2, and so on. Each answer part should cite passages allowed for its task.&lt;br&gt;&lt;br&gt;&lt;b&gt;Purpose:&lt;/b&gt; provide the source text Gemma uses and Python can check. A retrieved passage may still be incomplete or misleading.&lt;br&gt;&lt;br&gt;&lt;b&gt;Missing support:&lt;/b&gt; a task without enough evidence may be marked unavailable." vertex="1">
          <mxGeometry height="206" width="566" x="16" y="704" as="geometry" />
        </mxCell>
        <mxCell id="g3" parent="g_a" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=40;spacingRight=40;fontSize=13;fontColor=#202124;fillColor=#fff4ce;strokeColor=#e2b94b;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;G3&lt;/font&gt;&amp;nbsp; &lt;b&gt;Corrections answer every task?&lt;/b&gt;" vertex="1">
          <mxGeometry height="124" width="250" x="332" y="26" as="geometry" />
        </mxCell>
        <mxCell id="g4" parent="g_a" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;G4&lt;/font&gt;&amp;nbsp; &lt;b&gt;Build the grounded prompt&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;One detail per task with its allowed source labels. Passages are marked UNTRUSTED: data, never instructions.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;generate_grounded_draft()&lt;/font&gt;" vertex="1">
          <mxGeometry height="124" width="250" x="332" y="184" as="geometry" />
        </mxCell>
        <mxCell id="g5" parent="g_a" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#ffe2c0;strokeColor=#e59945;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;G5&lt;/font&gt;&amp;nbsp; &lt;b&gt;Gemma draft&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;One call to gemma3:4b, temperature 0. One record per task: availability, source_ids, answer. Unsupported means unavailable.&lt;/font&gt;" vertex="1">
          <mxGeometry height="118" width="250" x="332" y="350" as="geometry" />
        </mxCell>
        <mxCell id="g_truth" parent="g_a" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=14;fontColor=#202124;fillColor=#e3f1e1;strokeColor=#5f9a60;strokeWidth=2;" value="&lt;b style=&quot;font-size:16px&quot;&gt;Selected evidence&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;Passages S1 … Sn selected for this question. Passed in memory to Gemma and the answer checks; originally retrieved from the index.&lt;/font&gt;" vertex="1">
          <mxGeometry height="170" width="250" x="332" y="510" as="geometry" />
        </mxCell>
        <mxCell id="g_gates" parent="g_a" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;container=1;collapsible=0;pointerEvents=0;fillColor=#f8f4fb;strokeColor=#aa81c5;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;spacing=0;fontSize=13;fontColor=#555555;" value="&lt;b&gt;Verification gates: check each record against the question and selected evidence. A failed check can reject that record. No model call.&lt;/b&gt;" vertex="1">
          <mxGeometry height="636" width="598" x="632" y="24" as="geometry" />
        </mxCell>
        <mxCell id="g_gate1" parent="g_gates" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=3;spacingLeft=8;spacingRight=8;fontSize=12;fontColor=#333333;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1;" value="&lt;b&gt;1. Citations.&lt;/b&gt; The task is resolved, at least one label is cited, and every cited label exists." vertex="1">
          <mxGeometry height="44" width="570" x="14" y="46" as="geometry" />
        </mxCell>
        <mxCell id="g_gate2" parent="g_gates" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=3;spacingLeft=8;spacingRight=8;fontSize=12;fontColor=#333333;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1;" value="&lt;b&gt;2. Task scope.&lt;/b&gt; Labels must come from this task&#39;s passages and papers. Others are dropped only if the number gate can still prove the answer." vertex="1">
          <mxGeometry height="44" width="570" x="14" y="100" as="geometry" />
        </mxCell>
        <mxCell id="g_gate3" parent="g_gates" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=3;spacingLeft=8;spacingRight=8;fontSize=12;fontColor=#333333;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1;" value="&lt;b&gt;3. Named variant.&lt;/b&gt; A requested benchmark year must be in a cited paragraph. A requested model size or version must not conflict with it." vertex="1">
          <mxGeometry height="44" width="570" x="14" y="154" as="geometry" />
        </mxCell>
        <mxCell id="g_gate4" parent="g_gates" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=3;spacingLeft=8;spacingRight=8;fontSize=12;fontColor=#333333;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1;" value="&lt;b&gt;4. Unit.&lt;/b&gt; A request for dollars or GPU hours needs that unit in both the answer and the cited text." vertex="1">
          <mxGeometry height="44" width="570" x="14" y="208" as="geometry" />
        </mxCell>
        <mxCell id="g_gate5" parent="g_gates" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=3;spacingLeft=8;spacingRight=8;fontSize=12;fontColor=#333333;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1;" value="&lt;b&gt;5. Answer text.&lt;/b&gt; Not empty, and does not say the fact is “not specified”." vertex="1">
          <mxGeometry height="32" width="570" x="14" y="262" as="geometry" />
        </mxCell>
        <mxCell id="g_gate6" parent="g_gates" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=3;spacingLeft=8;spacingRight=8;fontSize=12;fontColor=#333333;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1;" value="&lt;b&gt;6. Numbers.&lt;/b&gt; Every number must appear in the cited text (180K = 180,000, eight = 8). If not, search this task&#39;s other passages and add that citation." vertex="1">
          <mxGeometry height="44" width="570" x="14" y="304" as="geometry" />
        </mxCell>
        <mxCell id="g_gate7" parent="g_gates" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=3;spacingLeft=8;spacingRight=8;fontSize=12;fontColor=#333333;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1;" value="&lt;b&gt;7. Property.&lt;/b&gt; The sentence holding the value must name what was asked: batch size, learning rate, a named benchmark." vertex="1">
          <mxGeometry height="44" width="570" x="14" y="358" as="geometry" />
        </mxCell>
        <mxCell id="g_gate8" parent="g_gates" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=3;spacingLeft=8;spacingRight=8;fontSize=12;fontColor=#333333;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1;" value="&lt;b&gt;8. Named kind.&lt;/b&gt; “Which optimizer?” must name an optimizer. Same for hardware, tokenizer, activation and others." vertex="1">
          <mxGeometry height="44" width="570" x="14" y="412" as="geometry" />
        </mxCell>
        <mxCell id="g_gate9" parent="g_gates" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=3;spacingLeft=8;spacingRight=8;fontSize=12;fontColor=#333333;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1;" value="&lt;b&gt;9. Rate vs total.&lt;/b&gt; A per-unit value cannot be given as a total when the passages also state the total." vertex="1">
          <mxGeometry height="44" width="570" x="14" y="466" as="geometry" />
        </mxCell>
        <mxCell id="g_gate10" parent="g_gates" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=3;spacingLeft=8;spacingRight=8;fontSize=12;fontColor=#333333;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1;" value="&lt;b&gt;10. Training stage.&lt;/b&gt; A value tied to another stage is rejected. If the whole-run total was given and the passages state the stage&#39;s own figure, that sentence replaces the answer and must pass every gate again." vertex="1">
          <mxGeometry height="60" width="570" x="14" y="520" as="geometry" />
        </mxCell>
        <mxCell id="g_gate11" parent="g_gates" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=3;spacingLeft=8;spacingRight=8;fontSize=12;fontColor=#333333;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1;" value="&lt;b&gt;11. Named source.&lt;/b&gt; “According to the X paper” needs a citation from X." vertex="1">
          <mxGeometry height="32" width="570" x="14" y="590" as="geometry" />
        </mxCell>
        <mxCell id="g6" parent="g_a" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#e8ebee;strokeColor=#9aa4ad;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;G6&lt;/font&gt;&amp;nbsp; &lt;b&gt;Rejected record&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;Reason saved in the trace. This task becomes a missing part; the other tasks carry on.&lt;/font&gt;" vertex="1">
          <mxGeometry height="108" width="250" x="1280" y="184" as="geometry" />
        </mxCell>
        <mxCell id="g7" parent="g_a" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;G7&lt;/font&gt;&amp;nbsp; &lt;b&gt;Add premise corrections&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;The task&#39;s answer becomes the paper&#39;s own sentence: “This question assumes something the paper rules out…”&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;add_premise_corrections()&lt;/font&gt;" vertex="1">
          <mxGeometry height="124" width="250" x="648" y="704" as="geometry" />
        </mxCell>
        <mxCell id="g8" parent="g_a" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;G8&lt;/font&gt;&amp;nbsp; &lt;b&gt;Compute status and format&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;All tasks covered: answered. Some: partial + “Missing information”. None: abstained. No model call.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;format_cited_answer()&lt;/font&gt;" vertex="1">
          <mxGeometry height="124" width="250" x="964" y="704" as="geometry" />
        </mxCell>
        <mxCell id="g9" parent="g_a" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#dce9fa;strokeColor=#6da5df;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;G9&lt;/font&gt;&amp;nbsp; &lt;b&gt;Final answer&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;Text with [S1] labels. Source cards come from stored metadata, never from model-written links.&lt;/font&gt;" vertex="1">
          <mxGeometry height="124" width="250" x="1280" y="704" as="geometry" />
        </mxCell>
        <mxCell id="g_boundary" parent="g_a" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=12;fontColor=#333333;fillColor=#fffdf4;strokeColor=#e2b94b;strokeWidth=1;verticalAlign=middle;spacing=4;spacingLeft=10;" value="&lt;b&gt;Reference boundary.&lt;/b&gt; Reference answers from evaluation never enter the planner, retrieval or this process. They stay outside the app and are used only afterwards, to grade the final answer." vertex="1">
          <mxGeometry height="58" width="882" x="648" y="852" as="geometry" />
        </mxCell>
