          <mxGeometry height="92" width="250" x="1280" y="350" as="geometry" />
        </mxCell>
        <mxCell id="r11" parent="r_a" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size: 11px;&quot;&gt;R11&lt;/font&gt;&amp;nbsp; &lt;b&gt;Experimental keyword override&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size: 12px;&quot;&gt;With several tasks, MiniLM&#39;s top passage stays first and the best accepted BM25 passage moves second.&lt;/font&gt;" vertex="1">
          <mxGeometry height="104" width="250" x="1280" y="719" as="geometry" />
        </mxCell>
        <mxCell id="r12" parent="r_a" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size: 11px;&quot;&gt;R12&lt;/font&gt;&amp;nbsp; &lt;b&gt;Experimental&lt;/b&gt;&amp;nbsp;&lt;b&gt;Premise check&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size: 12px;&quot;&gt;For some question types, Python looks for a sentence in the paper that shows contradiction.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#666666&quot; style=&quot;font-size: 11px;&quot;&gt;find_premise_ruling()&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="250" x="964" y="706" as="geometry" />
        </mxCell>
        <mxCell id="r_card_scope" parent="r_a" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=12;fontColor=#333333;fillColor=#fbfbf9;strokeColor=#b8b8b3;strokeWidth=1;" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Three task scopes — with examples&lt;/b&gt;&lt;/div&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:13px;margin-top:4px&quot; cellpadding=&quot;5&quot;&gt;&lt;tr style=&quot;border-bottom:1px solid #cfcfca&quot;&gt;&lt;td style=&quot;width:130px&quot;&gt;&lt;b&gt;paper&lt;/b&gt;&lt;/td&gt;&lt;td&gt;“What optimizer does BERT use?” → search BERT. A task may name several verified papers, or carry possible candidates for retrieval to resolve.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #cfcfca&quot;&gt;&lt;td&gt;&lt;b&gt;broad&lt;/b&gt;&lt;/td&gt;&lt;td&gt;“Which papers discuss retrieval?” → search across the collection; guide and catalog can join keyword search.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;unresolved&lt;/b&gt;&lt;/td&gt;&lt;td&gt;“What optimizer did Orion-4 use?” → if no paper or candidates can be identified, skip this task and report it unanswered.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;font style=&quot;font-size:11px&quot;&gt;These are illustrative outcomes; the actual scope depends on the planner and catalog.&lt;/font&gt;" vertex="1">
          <mxGeometry height="202" width="882" x="648" y="26" as="geometry" />
        </mxCell>
        <mxCell id="e18_r1_r2" edge="1" parent="r_a" source="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="r2" value="">
