          <mxGeometry height="112" width="250" x="16" y="364" as="geometry" />
        </mxCell>
        <mxCell id="x14" parent="x_c" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=5;fontSize=14;fontColor=#202124;fillColor=#dce9fa;strokeColor=#6da5df;strokeWidth=1.5;" value="&lt;font color=&quot;#6f6f6f&quot; style=&quot;font-size:11px&quot;&gt;X14&lt;/font&gt;&amp;nbsp; &lt;b&gt;Sections&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px&quot;&gt;Text, location, heading path, level, reference label, extraction method, confidence.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;ExtractedSection&lt;/font&gt;" vertex="1">
