      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#202124;" value="&lt;b style=&quot;font-size:32px&quot;&gt;Research RAG Agent: how each part works&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:15px&quot;&gt;Box 1 runs beforehand and builds the index that boxes 2 and 3 read. At question time the flow is 2 → 3 → 4. Drawn from the app code at commit a3c8e0a0.&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="1600" x="40" y="20" as="geometry" />
        </mxCell>
