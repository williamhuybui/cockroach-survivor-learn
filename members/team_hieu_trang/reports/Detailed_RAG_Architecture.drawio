<mxfile host="app.diagrams.net"><diagram name="Detailed system flow"><mxGraphModel grid="1" page="1" pageWidth="1800" pageHeight="2300" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;Research RAG Agent: detailed system architecture&lt;/b&gt;" vertex="1" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontColor=#202124;"><mxGeometry x="25" y="12" width="1650" height="48" as="geometry" /></mxCell><mxCell id="L1" value="&lt;b&gt;A. Prepare the research knowledge base&lt;/b&gt;" vertex="1" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=14;fontSize=20;fillColor=#f7f7f6;strokeColor=#d7d7d4;strokeWidth=1.5;"><mxGeometry x="25" y="75" width="1650" height="365" as="geometry" /></mxCell><mxCell id="a1" value="&lt;b&gt;Google Drive&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;Research PDFs, index.csv and guide&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=15;fillColor=#dce9fa;strokeColor=#6da5df;strokeWidth=1.5;"><mxGeometry x="55" y="145" width="270" height="92" as="geometry" /></mxCell><mxCell id="a2" value="&lt;b&gt;Sync + track&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;drive_sync.py&lt;br&gt;Download and write manifest&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=15;fillColor=#eee5f5;strokeColor=#aa81c5;strokeWidth=1.5;"><mxGeometry x="380" y="145" width="270" height="92" as="geometry" /></mxCell><mxCell id="a3" value="&lt;b&gt;Extract regions&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;Neural layout model + PyMuPDF&lt;br&gt;Headings, prose and captions&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;arcS