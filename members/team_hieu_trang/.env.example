# Local storage paths default to data/chroma and data/app.sqlite3.
# No database server or Docker is needed.

# Local Ollama models
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=gemma3:4b
EMBED_MODEL=embeddinggemma
EMBED_DIM=768
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# Passages below this MiniLM score are dropped; 1.5 stops off-topic questions
# before Gemma answers (all answerable dev/unseen questions score above 1.6).
MIN_RERANK_SCORE=1.5

# Warn periodically while neural work continues; this never triggers fallback.
PDF_LAYOUT_WARN_SECONDS=30

# Warn periodically while neural work continues; this never triggers fallback.
PDF_LAYOUT_WARN_SECONDS=30

# Copy the ID after /folders/ in your research-paper folder URL.
# Set exactly one folder. Old multi-folder settings are no longer used.
RESEARCH_FOLDER_ID=
TEAM_TIMEZONE=America/Chicago

# Default source list is sources.local.json in the project folder.
# SOURCE_MANIFEST_PATH=C:/path/to/sources.local.json

# Optional tracing. Leave disabled to keep retrieved text local.
LANGSMITH_TRACING=false
