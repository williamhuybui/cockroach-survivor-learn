# Local storage paths default to data/chroma and data/app.sqlite3.
# No database server or Docker is needed.

# Local Ollama models
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=gemma3:4b
EMBED_MODEL=embeddinggemma
EMBED_DIM=768
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
MIN_RERANK_SCORE=0

# Copy the ID after /folders/ in your research-paper folder URL.
# Set exactly one folder. Old multi-folder settings are no longer used.
RESEARCH_FOLDER_ID=
TEAM_TIMEZONE=America/Chicago

# Optional tracing. Leave disabled to keep retrieved text local.
LANGSMITH_TRACING=false
